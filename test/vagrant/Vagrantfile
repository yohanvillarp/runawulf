# -*- mode: ruby -*-
# vi: set ft=ruby :
# ==============================================================================
# Runawulf — Vagrantfile for Ubuntu 22.04 LTS Kernel & eBPF Sandboxing
# ==============================================================================

Vagrant.configure("2") do |config|
  # Canonical Ubuntu 22.04 LTS (Jammy Jellyfish) with Kernel 5.15+
  config.vm.box = "generic/ubuntu2204"
  config.vm.box_check_update = false

  # Network Configuration
  # 4000: Runawulf Web Console & Control Plane API
  config.vm.network "forwarded_port", guest: 4000, host: 4000, auto_correct: true
  # 9090: Prometheus Metrics Export (Sensor & Core Engine)
  config.vm.network "forwarded_port", guest: 9090, host: 9090, auto_correct: true

  # Synced Folders (Mount repo into guest at /home/vagrant/runawulf)
  config.vm.synced_folder ".", "/home/vagrant/runawulf", type: "virtualbox", mount_options: ["dmode=775", "fmode=664"]

  # Provider: VirtualBox
  config.vm.provider "virtualbox" do |vb|
    vb.name = "runawulf-e2e-node"
    vb.memory = "2048"
    vb.cpus = 2
    vb.customize ["modifyvm", :id, "--nested-hw-virt", "on"]
  end

  # Provider: Libvirt (KVM / QEMU on Linux hosts)
  config.vm.provider "libvirt" do |lv|
    lv.memory = 2048
    lv.cpus = 2
    lv.nested = true
  end

  # Provisioning
  config.vm.provision "shell", path: "test/vagrant/provision.sh"

  config.vm.post_up_message = <<-MESSAGE
  ----------------------------------------------------------------------
  🐺 Runawulf Linux Kernel Sandbox is UP!
  
  To enter the VM:
    vagrant ssh
  
  Inside the VM:
    cd /home/vagrant/runawulf
    npm install
    make bpf
    npm run build
    sudo make install
    sudo systemctl status runawulf-helper.socket
  
  Control plane accessible at: http://localhost:4000
  ----------------------------------------------------------------------
  MESSAGE
end
